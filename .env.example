# This is an example environment file.
# Copy this file to .env and fill in your actual values.
# Do NOT commit the .env file to version control.

# --- Proxmox PVE API credentials ---
# GuestOS uses user + password against the Proxmox API (not API-token env vars).
# Prefer a dedicated least-privilege user over root@pam.
PROXMOX_HOST=pve.example.com
PROXMOX_USER=guestos@pve
PROXMOX_PASSWORD=your_proxmox_password
# Verify the Proxmox API TLS certificate. Set True in production with a trusted
# CA; False is only for lab self-signed PVE certs.
PROXMOX_VERIFY_SSL=False

# Optional Redis password for Compose. When set, deploy/compose-redis-env.sh
# rewrites default CELERY_* URLs to redis://:PASSWORD@redis:6379/0.
# Set this for any non-lab deploy (unauthenticated Redis can read task secrets).
# REDIS_PASSWORD=

# --- Network Configuration ---
# Primary bridge for the final VM network interface (defaults to vmbr0 in code
# if unset; set explicitly to match your cluster).
PRIMARY_BRIDGE=vmbr0

# Set to true if running behind a reverse proxy (TLS terminator).
# Enables Secure session cookies and ProxyFix for X-Forwarded-* headers.
BEHIND_REVERSE_PROXY=False

# Optional path prefix when GuestOS is mounted under a subpath (e.g. /guestos).
# Leave empty when TLS proxy serves GuestOS at https://host/ (site root).
# GUESTOS_PATH_PREFIX=

# Public hostname/IP used by the Compose Caddy TLS service (SAN / Caddyfile).
# Required for the recommended Compose HTTPS path (operators open this URL).
# Example: guestos.example.com  (lab may use a host IP instead)
# GUESTOS_TLS_HOST=guestos.example.com

# Shared HMAC secret for PDM → GuestOS one-click /launch URLs (must match
# launch-secret in PDM /etc/proxmox-datacenter-manager/guestos.cfg).
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
# GUESTOS_LAUNCH_SECRET=
# CORS off by default (PDM proxies /api/tasks). Lab-only direct browser calls:
# GUESTOS_CORS_ORIGINS=*
# Or restrict to PDM UI origin(s), comma-separated:
# GUESTOS_CORS_ORIGINS=https://pdm.example.com:8443

# Optional Sysprep timing overrides (seconds). Production should leave unset.
# Lab/smoke can lower these when guests boot quickly.
# SYSPREP_BOOT_SETTLE_SECONDS=180
# SYSPREP_AGENT_STABLE_SECONDS=60
# Honor request fast_waits=true (lab smoke only). Default false.
# ALLOW_FAST_WAITS=true

# Bulk / provisioning safeguards (no override — use PVE for exceptions).
# BULK_MAX_ITEMS=10
# BULK_MAX_INFLIGHT_BATCHES=10
# BULK_MAX_CONCURRENT_PER_REMOTE=10
# BULK_MAX_CONCURRENT_GLOBAL=10
# PROVISION_MAX_PER_DAY=20
# Auto-fail orphan PROGRESS/PENDING tasks with no update for this many seconds (default 6h).
# TASK_STALE_AFTER_SECONDS=21600
# WIN11_MAX_CORES=8
# WIN11_MAX_RAM_MB=65536
# WIN11_MAX_DISK_GB=600
# SERVER_MAX_CORES=16
# SERVER_MAX_RAM_MB=65536
# SERVER_MAX_DISK_GB=2048
# STORAGE_WARN_PCT=65
# STORAGE_BLOCK_PCT=80

# --- Machine API (PDM / integrators) ---
# Bearer or X-Api-Token for sysprep start/poll without a browser session.
# GUESTOS_API_TOKEN=change-me-to-a-long-random-string
# Or multiple: API_TOKENS=token-one,token-two

# Named Proxmox remotes for multi-cluster / PDM (JSON object). Omit remote_id
# in requests to use the default PROXMOX_HOST/USER/PASSWORD above.
# PVE_REMOTES_JSON={"lab":{"host":"pve.lab.example","user":"api@pve","password":"secret","verify_ssl":false}}

# --- Database ---
# SQLAlchemy database URL. Defaults to a local SQLite file under instance/.
# DATABASE_URL=sqlite:///site.db

# --- Celery / Redis ---
# Broker and result backend. Defaults to a local Redis instance.
# In docker-compose these are overridden to point at the redis service.
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Flask Secret Key ---
# REQUIRED: a long, random string used to secure sessions and CSRF tokens.
# The app will refuse to start if this is not set.
# You can generate one with: python -c 'import secrets; print(secrets.token_hex())'
SECRET_KEY=change_this_to_a_random_string

# --- Application Port ---
# Port the web application will listen on.
PORT=5001

# --- Domain Profiles (JSON format) ---
# This is a JSON string that defines profiles for domain joining.
# You can define multiple profiles.
# Note: This needs to be a single line of valid JSON.
# Optional keys per profile: dns_servers, domain_name, domain_username,
# domain_password, vlan (optional network shortcut), domain_ou (sysprep join target OU).
# Usernames must be UPN (user@domain.tld) or DOMAIN\user — bare names are rejected.
DOMAIN_PROFILES_JSON={"Example Corp": {"dns_servers": "10.0.0.1,10.0.0.2", "domain_name": "corp.example.com", "domain_username": "join_user@corp.example.com", "domain_password": "your_domain_join_password", "vlan": 100, "domain_ou": "OU=Servers,DC=corp,DC=example,DC=com"}, "Example Lab": {"dns_servers": "192.168.1.1", "domain_name": "lab.local", "domain_username": "lab_admin@lab.local", "domain_password": "your_lab_password", "vlan": 200}}

# Pre-Sysprep in-clone AD credential probe (QGA LDAP/ADSI bind). Default true.
# DOMAIN_JOIN_CRED_PROBE=false
# DOMAIN_JOIN_CRED_PROBE_WAIT_SECONDS=90
