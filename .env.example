# This is an example environment file.
# Copy this file to .env and fill in your actual values.
# Do NOT commit the .env file to version control.

# --- Proxmox PVE API credentials ---
PROXMOX_HOST=pve.example.com
PROXMOX_USER=root@pam
PROXMOX_PASSWORD=your_proxmox_password
# Verify the Proxmox API TLS certificate. Leave False for self-signed certs
# (typical homelab); set True when using a trusted certificate.
PROXMOX_VERIFY_SSL=False

# --- WinRM Credentials ---
# Default credentials for connecting to the guest VMs.
WINRM_USERNAME=Administrator
WINRM_PASSWORD=your_winrm_password

# --- Network Configuration ---
# Subnet for the temporary WinRM network.
WINRM_SUBNET=192.168.100.0/24
# Primary bridge for the final VM network interface.
PRIMARY_BRIDGE=vmbr0
# Temporary bridge for the WinRM network interface.
TEMP_BRIDGE=vmbr1

# Set to true if running behind a reverse proxy
BEHIND_REVERSE_PROXY=False

# Optional override for the UI/footer version string (defaults to the VERSION file).
# APP_VERSION=1.4.3

# --- Machine API (PDM / integrators) ---
# Bearer or X-Api-Token for sysprep start/poll without a browser session.
# GUESTOS_API_TOKEN=change-me-to-a-long-random-string
# Or multiple: API_TOKENS=token-one,token-two

# Named Proxmox remotes for multi-cluster / PDM (JSON object). Omit remote_id
# in requests to use the default PROXMOX_HOST/USER/PASSWORD above.
# PVE_REMOTES_JSON={"lab":{"host":"pve.lab.example","user":"api@pve","password":"secret","verify_ssl":false}}

# --- Database ---
# SQLAlchemy database URL. Defaults to a local SQLite file under instance/.
# DATABASE_URL=sqlite:///site.db

# --- Celery / Redis ---
# Broker and result backend. Defaults to a local Redis instance.
# In docker-compose these are overridden to point at the redis service.
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Flask Secret Key ---
# REQUIRED: a long, random string used to secure sessions and CSRF tokens.
# The app will refuse to start if this is not set.
# You can generate one with: python -c 'import secrets; print(secrets.token_hex())'
SECRET_KEY=change_this_to_a_random_string

# --- Application Port ---
# Port the web application will listen on.
PORT=5001

# --- Domain Profiles (JSON format) ---
# This is a JSON string that defines profiles for domain joining.
# You can define multiple profiles.
# Note: This needs to be a single line of valid JSON.
# Optional keys per profile: dns_servers, domain_name, domain_username,
# domain_password, vlan (WinRM reconfigure), domain_ou (sysprep join target OU).
DOMAIN_PROFILES_JSON={"Example Corp": {"dns_servers": "10.0.0.1,10.0.0.2", "domain_name": "corp.example.com", "domain_username": "join_user@corp.example.com", "domain_password": "your_domain_join_password", "vlan": 100, "domain_ou": "OU=Servers,DC=corp,DC=example,DC=com"}, "Example Lab": {"dns_servers": "192.168.1.1", "domain_name": "lab.local", "domain_username": "lab_admin", "domain_password": "your_lab_password", "vlan": 200}}