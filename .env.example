# This is an example environment file.
# Copy this file to .env and fill in your actual values.
# Do NOT commit the .env file to version control.

# --- Proxmox PVE API credentials ---
PROXMOX_HOST=pve.example.com
PROXMOX_USER=root@pam
PROXMOX_PASSWORD=your_proxmox_password

# --- WinRM Credentials ---
# Default credentials for connecting to the guest VMs.
WINRM_USERNAME=Administrator
WINRM_PASSWORD=your_winrm_password

# --- Network Configuration ---
# Subnet for the temporary WinRM network.
WINRM_SUBNET=192.168.100.0/24
# Primary bridge for the final VM network interface.
PRIMARY_BRIDGE=vmbr0
# Temporary bridge for the WinRM network interface.
TEMP_BRIDGE=vmbr1

# --- Flask Secret Key ---
# A long, random string used to secure sessions.
# You can generate one with: python -c 'import secrets; print(secrets.token_hex())'
SECRET_KEY=change_this_to_a_random_string

# --- Application Port ---
# Port the web application will listen on.
PORT=5001

# --- Domain Profiles (JSON format) ---
# This is a JSON string that defines profiles for domain joining.
# You can define multiple profiles.
# Note: This needs to be a single line of valid JSON.
DOMAIN_PROFILES_JSON={"Example Corp": {"dns_servers": "10.0.0.1,10.0.0.2", "domain_name": "corp.example.com", "domain_username": "join_user@corp.example.com", "domain_password": "your_domain_join_password", "vlan": 100}, "Example Lab": {"dns_servers": "192.168.1.1", "domain_name": "lab.local", "domain_username": "lab_admin", "domain_password": "your_lab_password", "vlan": 200}}