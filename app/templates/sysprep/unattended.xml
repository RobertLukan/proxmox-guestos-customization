<?xml version="1.0" encoding="utf-8"?>
<unattend xmlns="urn:schemas-microsoft-com:unattend">
    <!--
      specialize: hostname/timezone + enable built-in Administrator + register
      GuestOS-Setup (SYSTEM AtStartup scheduled task). setup.ps1 is delivered via
      HKLM\SOFTWARE\GuestOS SetupPs1B64 (survives specialize cleanup). The task
      extracts and runs it after OOBE — no AutoLogon / FirstLogonCommands.

      Client OOBE (Win10/11) requires a LocalAccounts entry when AutoLogon is
      absent; HideLocalAccountScreen only applies to Server. A short-lived
      GuestOSOobe admin satisfies the "Who's going to use this device?" page;
      setup.ps1 removes it after enabling built-in Administrator.

      Evaluation vs volume-license is one template with Jinja branches — not separate files:
      - VL Server: optional Shell-Setup ProductKey (GVLK) so OOBE skips Enter product key
      - Evaluation: never inject a VL GVLK; mark product-key OOBE as already shown so
        InstallPid does not fail with 0xC004F015 and leave the guest stuck in OOBE
    -->
    <settings pass="specialize">
        <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            <ComputerName>{{ hostname }}</ComputerName>
            {% if timezone %}<TimeZone>{{ timezone }}</TimeZone>{% endif %}
            {# Optional ProductKey (operator or Server GVLK). Do NOT use
               Microsoft-Windows-Setup UserData/WillShowUI here — empty Key in
               specialize fails with "could not apply unattend settings".
               Evaluation guests must omit this (see windows_evaluation branch). #}
            {% if product_key and not windows_evaluation %}<ProductKey>{{ product_key }}</ProductKey>{% endif %}
        </component>
        <component name="Microsoft-Windows-Deployment" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            <RunSynchronous>
                <RunSynchronousCommand wcm:action="add">
                    <Order>1</Order>
                    <Description>Enable built-in Administrator for GuestOS local admin</Description>
                    <Path>cmd.exe /c net user Administrator /active:yes</Path>
                </RunSynchronousCommand>
                <RunSynchronousCommand wcm:action="add">
                    <Order>2</Order>
                    <Description>GuestOS: mark unattend-created user for OOBE</Description>
                    <Path>cmd.exe /c reg add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Setup\OOBE" /v UnattendCreatedUser /t REG_DWORD /d 1 /f{% if windows_evaluation %} &amp; reg add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Setup\OOBE" /v SetupDisplayedProductKey /t REG_DWORD /d 1 /f{% endif %}</Path>
                </RunSynchronousCommand>
                <RunSynchronousCommand wcm:action="add">
                    <Order>3</Order>
                    <Description>GuestOS: register SYSTEM AtStartup setup task</Description>
                    <Path>cmd.exe /c C:\Windows\System32\GuestOS-RegisterSetup.cmd</Path>
                </RunSynchronousCommand>
            </RunSynchronous>
        </component>
    </settings>
    <settings pass="oobeSystem">
        <component name="Microsoft-Windows-International-Core" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            <InputLocale>{{ locale }}</InputLocale>
            <SystemLocale>{{ locale }}</SystemLocale>
            <UILanguage>{{ locale }}</UILanguage>
            <UserLocale>{{ locale }}</UserLocale>
        </component>
        <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            <OOBE>
                <HideEULAPage>true</HideEULAPage>
                <ProtectYourPC>1</ProtectYourPC>
                <HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE>
                <HideOnlineAccountScreens>true</HideOnlineAccountScreens>
                <HideLocalAccountScreen>true</HideLocalAccountScreen>
                <HideOEMRegistrationScreen>true</HideOEMRegistrationScreen>
            </OOBE>
            <UserAccounts>
                <AdministratorPassword>
                    <Value>{{ administrator_password }}</Value>
                    <PlainText>true</PlainText>
                </AdministratorPassword>
                {# Win10/11 client OOBE still prompts for a user name unless a
                   LocalAccounts entry exists (HideLocalAccountScreen is Server-only).
                   GuestOSOobe is removed by setup.ps1 account cleanup. #}
                <LocalAccounts>
                    <LocalAccount wcm:action="add">
                        <Name>GuestOSOobe</Name>
                        <DisplayName>GuestOS</DisplayName>
                        <Group>Administrators</Group>
                        <Password>
                            <Value>{{ administrator_password }}</Value>
                            <PlainText>true</PlainText>
                        </Password>
                    </LocalAccount>
                </LocalAccounts>
            </UserAccounts>
            {# No AutoLogon / FirstLogonCommands: GuestOS-Setup (SYSTEM AtStartup) runs setup.ps1. #}
        </component>
    </settings>
</unattend>
